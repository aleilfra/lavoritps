
<!DOCTYPE html>
<html>
<head>
    <title>Dati COVID Italia</title>
</head>
<body>

    <h2>Andamento COVID-19 in Italia</h2>

    <table border="1" id="tabella"></table>

    <script>
        const x = new XMLHttpRequest();

        x.open("GET", "https://raw.githubusercontent.com/pcm-dpc/COVID-19/master/dati-json/dpc-covid19-ita-andamento-nazionale.json", true);

        x.onload = function() {

            const obj = JSON.parse(x.responseText);

            const numeroChiavi = Object.keys(obj[0]).length;

            const keys = Object.keys(obj[0]);

            let tabella = document.getElementById("tabella");

            let intestazione = "<tr>";

            for (let i = 0; i < numeroChiavi; i++) {
                intestazione += "<th>" + keys[i] + "</th>";
            }

            intestazione += "</tr>";

            tabella.innerHTML = intestazione;

            for (let i = 0; i < obj.length; i++) {

                let riga = "<tr>";

                for (let j = 0; j < numeroChiavi; j++) {
                    riga += "<td>" + obj[i][keys[j]] + "</td>";
                }

                riga += "</tr>";

                tabella.innerHTML += riga;
            }
        };

        x.send();
    </script>

</body>
</html>
